<Application x:Class="GpsTrackerPc.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#0B1220" />
    <SolidColorBrush x:Key="AppSurface" Color="#111A2E" />
    <SolidColorBrush x:Key="AppSurfaceAlt" Color="#0F172A" />
    <SolidColorBrush x:Key="AppBorder" Color="#1E293B" />
    <SolidColorBrush x:Key="AppBorderStrong" Color="#334155" />
    <SolidColorBrush x:Key="AppText" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppTextSoft" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppAccent" Color="#38BDF8" />
    <SolidColorBrush x:Key="AppSuccess" Color="#22C55E" />
    <SolidColorBrush x:Key="AppSuccessText" Color="#86EFAC" />
    <SolidColorBrush x:Key="AppDangerText" Color="#FCA5A5" />
    <SolidColorBrush x:Key="AppDangerSurface" Color="#3B1D1D" />
    <SolidColorBrush x:Key="AppDangerBorder" Color="#7F1D1D" />
    <SolidColorBrush x:Key="AppOverlayBackground" Color="#CC0B1220" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AppBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Background" Value="{DynamicResource AppBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{DynamicResource AppBorder}" />
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
    </Style>
  </Application.Resources>
</Application>
