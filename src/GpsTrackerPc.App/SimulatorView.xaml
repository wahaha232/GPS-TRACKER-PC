<UserControl x:Class="GpsTrackerPc.App.SimulatorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Loaded="View_Loaded"
        Background="{DynamicResource AppBackground}">
<UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource AppButton}">
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{DynamicResource AppBorder}" />
      <Setter Property="Margin" Value="0,12" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,6" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="410" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
      <wv2:WebView2 x:Name="MapView" />

      <Border Background="{DynamicResource AppOverlayBackground}"
              CornerRadius="6"
              Padding="10,7"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="12">
        <TextBlock Text="點地圖新增路線點；拖曳圓點可移動；點圓點可在右側編輯。"
                   Foreground="{DynamicResource AppTextSoft}"
                   FontSize="12" />
      </Border>

      <Border x:Name="LoadingPanel" Background="{DynamicResource AppBackground}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="🗺️"
                     FontSize="44"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,10" />
          <TextBlock Text="正在載入模擬地圖…"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="14"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border x:Name="ErrorPanel"
              Background="{DynamicResource AppBackground}"
              Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="620">
          <TextBlock Text="地圖無法載入"
                     Foreground="{DynamicResource AppDangerText}"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10" />
          <TextBlock x:Name="ErrorText"
                     Foreground="{DynamicResource AppText}"
                     FontSize="13"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Column="1"
            Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1,0,0,0">
      <ScrollViewer x:Name="SideScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="16,14"
                    PreviewMouseWheel="SideScrollViewer_PreviewMouseWheel">
        <StackPanel>
          <Button Content="← 回首頁"
                  HorizontalAlignment="Left"
                  Padding="12,5"
                  Margin="0,0,0,10"
                  Click="BackToHome_Click" />
          <TextBlock Text="模擬路線編輯"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBlock Text="6A／6B：編輯、儲存、即時播放與直接產生。"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="12"
                     Margin="0,4,0,0" />

          <TextBlock Text="底圖" Style="{StaticResource Section}" />
          <ComboBox x:Name="BasemapBox"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectionChanged="Basemap_Changed" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ToggleButton x:Name="FollowToggle"
                          Content="跟隨"
                          Padding="14,5"
                          Margin="0,0,6,0"
                          Background="{DynamicResource AppBorder}"
                          Foreground="{DynamicResource AppText}"
                          BorderBrush="{DynamicResource AppBorderStrong}"
                          Checked="Follow_Changed"
                          Unchecked="Follow_Changed" />
            <Button Content="定位"
                    Padding="14,5"
                    Margin="0,0,6,0"
                    Click="Locate_Click" />
            <Button x:Name="CurrentLocationButton"
                    Content="📍 目前位置"
                    Padding="14,5"
                    Click="CurrentLocation_Click" />
          </StackPanel>

          <StackPanel x:Name="RouteEditPanel">
          <TextBlock Text="路線名稱" Style="{StaticResource Section}" />
          <TextBox x:Name="RouteNameBox" TextChanged="RouteNameBox_TextChanged" />
          <WrapPanel Margin="0,6,0,0">
            <Button Content="新路線" Margin="0,0,6,0" Click="NewRoute_Click" />
            <Button Content="儲存路線" Margin="0,0,6,0" Click="SaveRoute_Click" />
            <Button Content="已存路線" Click="SavedRoutes_Click" />
          </WrapPanel>

          <TextBlock Text="速度（km/h）" Style="{StaticResource Section}" />
          <WrapPanel x:Name="SpeedPresetPanel">
            <Button Content="走路 5" Tag="5" Margin="0,0,6,6" Click="SpeedPreset_Click" />
            <Button Content="跑步 10" Tag="10" Margin="0,0,6,6" Click="SpeedPreset_Click" />
            <Button Content="騎車 18" Tag="18" Margin="0,0,6,6" Click="SpeedPreset_Click" />
            <Button Content="開車 40" Tag="40" Margin="0,0,6,6" Click="SpeedPreset_Click" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="SpeedBox" Width="80" Text="5" />
            <Button x:Name="ApplySpeedButton" Content="套用速度" Margin="6,0,0,0" Click="ApplySpeed_Click" />
          </StackPanel>

          <CheckBox x:Name="LoopCheck" Content="循環路線" Checked="Option_Changed" Unchecked="Option_Changed" />
          <CheckBox x:Name="NaturalCheck" Content="速度自然起伏" Checked="Option_Changed" Unchecked="Option_Changed" />
          <CheckBox x:Name="TimingCheck" Content="依 GPX 時間播放（路線要有時間資料）" Checked="Option_Changed" Unchecked="Option_Changed" />
          <Button Content="套用"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0"
                  Click="ApplyRouteSettings_Click" />

          <Separator />
          <TextBlock Text="路線點" Style="{StaticResource Section}" />
          <TextBlock x:Name="WaypointSummaryText"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="12"
                     Margin="0,0,0,6" />
          <ListBox x:Name="WaypointList"
                   Height="150"
                   DisplayMemberPath="Display"
                   SelectionChanged="WaypointList_SelectionChanged" />
          <WrapPanel Margin="0,6,0,0">
            <Button Content="上移" Margin="0,0,6,0" Click="MoveUp_Click" />
            <Button Content="下移" Margin="0,0,6,0" Click="MoveDown_Click" />
            <Button Content="刪除選取點" Margin="0,0,6,0" Click="DeleteWaypoint_Click" />
            <Button Content="全部清除" Click="ClearWaypoints_Click" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="停留秒數" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="StopSecondsBox" Width="80" />
            <Button Content="套用停留" Margin="6,0,0,0" Click="ApplyStop_Click" />
          </StackPanel>

          <Separator />
          <TextBlock Text="GPS 中斷" Style="{StaticResource Section}" />
          <ListBox x:Name="OutageList"
                   Height="90"
                   DisplayMemberPath="Display" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="開始秒" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="OutageStartBox" Width="70" />
            <TextBlock Text="持續秒" VerticalAlignment="Center" Margin="8,0,6,0" />
            <TextBox x:Name="OutageDurationBox" Width="70" />
            <Button Content="新增" Margin="6,0,0,0" Click="AddOutage_Click" />
          </StackPanel>
          <Button Content="刪除選取中斷"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0"
                  Click="DeleteOutage_Click" />

          <Separator />
          <TextBlock Text="地點搜尋（Nominatim）" Style="{StaticResource Section}" />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="SearchBox" Width="260" />
            <Button x:Name="SearchButton" Content="搜尋" Margin="6,0,0,0" Click="Search_Click" />
          </StackPanel>
          <ListBox x:Name="SearchResultsList"
                   Height="110"
                   DisplayMemberPath="DisplayName"
                   Margin="0,6,0,0"
                   SelectionChanged="SearchResults_SelectionChanged" />

          <Separator />
          <TextBlock Text="收藏地點" Style="{StaticResource Section}" />
          <TextBox x:Name="FavoriteNameBox" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="加入目前地圖中心" Margin="0,0,6,0" Click="AddFavorite_Click" />
            <Button Content="刪除選取收藏" Click="DeleteFavorite_Click" />
          </StackPanel>
          <ListBox x:Name="FavoriteList"
                   Height="110"
                   DisplayMemberPath="Display"
                   Margin="0,6,0,0"
                   SelectionChanged="FavoriteList_SelectionChanged" />

          <Separator />
          <TextBlock Text="隨機路線" Style="{StaticResource Section}" />
          <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="ShapeBox" Width="130" SelectedIndex="0">
              <ComboBoxItem Content="隨機漫步" Tag="Walk" />
              <ComboBoxItem Content="環狀迴路" Tag="Loop" />
            </ComboBox>
            <TextBlock Text="點數" VerticalAlignment="Center" Margin="10,0,6,0" />
            <TextBox x:Name="RandomCountBox" Width="60" Text="30" />
            <TextBlock Text="半徑 m" VerticalAlignment="Center" Margin="8,0,6,0" />
            <TextBox x:Name="RandomRadiusBox" Width="80" Text="1000" />
          </StackPanel>
          <Button Content="以地圖中心產生"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0"
                  Click="GenerateRandom_Click" />
          </StackPanel>

          <Separator />
          <TextBlock Text="模擬播放" Style="{StaticResource Section}" />
          <WrapPanel>
            <Button x:Name="StartPlaybackButton" Content="開始" Margin="0,0,6,6" Click="StartPlayback_Click" />
            <Button x:Name="PausePlaybackButton" Content="暫停" Margin="0,0,6,6" Click="PausePlayback_Click" />
            <Button x:Name="ResumePlaybackButton" Content="繼續" Margin="0,0,6,6" Click="ResumePlayback_Click" />
            <Button x:Name="StopPlaybackButton" Content="停止" Margin="0,0,6,6" Click="StopPlayback_Click" />
          </WrapPanel>
          <WrapPanel Margin="0,2,0,0">
            <TextBlock Text="倍速" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="PlaybackSpeedBox"
                      Width="70"
                      SelectedIndex="0"
                      SelectionChanged="PlaybackSpeed_Changed">
              <ComboBoxItem Content="1x" Tag="1" />
              <ComboBoxItem Content="2x" Tag="2" />
              <ComboBoxItem Content="4x" Tag="4" />
              <ComboBoxItem Content="8x" Tag="8" />
            </ComboBox>
            <TextBlock Text="圈數" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox x:Name="LapsBox" Width="50" Text="1" />
            <Button x:Name="DirectGenerateButton"
                    Content="直接產生"
                    Margin="8,0,0,0"
                    Click="DirectGenerate_Click" />
            <Button x:Name="UploadRecordButton"
                    Content="上傳成紀錄"
                    Margin="8,0,0,0"
                    Click="UploadRecord_Click" />
          </WrapPanel>
          <ProgressBar x:Name="PlaybackProgress"
                       Height="8"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       Margin="0,8,0,0"
                       Background="{DynamicResource AppBorder}"
                       Foreground="{DynamicResource AppSuccess}" />
          <TextBlock x:Name="PlaybackOutageText"
                     Foreground="{DynamicResource AppDangerText}"
                     FontSize="12"
                     Margin="0,6,0,0" />
          <TextBlock x:Name="NetworkOutageText"
                     Foreground="{DynamicResource AppWarningText}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0" />
          <TextBlock x:Name="PlaybackMetaText"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="12"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap" />

          <Separator />
          <TextBlock Text="路線檔" Style="{StaticResource Section}" />
          <ComboBox x:Name="ImportedGpxBox"
                    DisplayMemberPath="Display"
                    SelectedValuePath="FilePath"
                    ToolTip="之前在匯入 GPX 頁面或模擬頁匯入過的檔案" />
          <TextBlock x:Name="ImportedGpxHint"
                     Text="還沒有匯入過的 GPX；用下面的「匯入 GPX／KML」選檔後會出現在這裡。"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0" />
          <WrapPanel Margin="0,6,0,0">
            <Button x:Name="LoadImportedGpxButton"
                    Content="載入選取的 GPX"
                    Margin="0,0,6,6"
                    Click="LoadImportedGpx_Click" />
            <Button Content="匯入 GPX／KML" Margin="0,0,6,6" Click="ImportRoute_Click" />
            <Button Content="匯出 GPX" Margin="0,0,6,6" Click="ExportGpx_Click" />
            <Button Content="匯出 KML" Margin="0,0,6,6" Click="ExportKml_Click" />
          </WrapPanel>

          <TextBlock x:Name="StatusText"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,12,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
