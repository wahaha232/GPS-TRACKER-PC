<Window x:Class="GpsTrackerPc.App.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPX 匯入"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="GPX 匯入"
                 Foreground="{DynamicResource AppText}"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <Border Background="{DynamicResource AppDangerSurface}"
              BorderBrush="{DynamicResource AppDangerBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12,9"
              Margin="0,10,0,0">
        <TextBlock Text="⚠️ 匯入的軌跡會寫入公開的 GitHub 倉庫，任何人都看得到路線（包含起點與終點）。步數不會匯入。"
                   Foreground="{DynamicResource AppDangerText}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </Border>
      <TextBlock x:Name="TokenStatusText"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 Margin="0,8,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,14,0,10">
      <Button x:Name="AddFilesButton"
              Content="選擇 GPX 檔"
              Padding="14,6"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="AddFiles_Click" />
      <TextBlock Text="也可以把 .gpx 拖進這個視窗"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0" />
      <TextBlock Text="移動方式"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 VerticalAlignment="Center"
                 Margin="28,0,8,0" />
      <ComboBox x:Name="ModeBox"
                Width="170"
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                Background="{DynamicResource AppSurfaceAlt}"
                Foreground="{DynamicResource AppText}"
                BorderBrush="{DynamicResource AppBorderStrong}" />
    </StackPanel>

    <ListView x:Name="FileList"
              Grid.Row="2"
              ItemsSource="{Binding Rows}"
              Background="{DynamicResource AppSurfaceAlt}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorder}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="檔案" Width="230" DisplayMemberBinding="{Binding FileName}" />
          <GridViewColumn Header="日期" Width="140" DisplayMemberBinding="{Binding DateText}" />
          <GridViewColumn Header="距離" Width="90" DisplayMemberBinding="{Binding DistanceText}" />
          <GridViewColumn Header="時間" Width="80" DisplayMemberBinding="{Binding DurationText}" />
          <GridViewColumn Header="點數" Width="60" DisplayMemberBinding="{Binding PointsText}" />
          <GridViewColumn Header="無時間" Width="70" DisplayMemberBinding="{Binding SkippedText}" />
          <GridViewColumn Header="狀態" Width="330" DisplayMemberBinding="{Binding Status}" />
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="3"
                Margin="0,12,0,0">
      <ProgressBar x:Name="Progress"
                   Height="7"
                   Minimum="0"
                   Maximum="1"
                   Background="{DynamicResource AppBorder}"
                   Foreground="{DynamicResource AppAccent}" />
      <TextBlock x:Name="StatusText"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button x:Name="ImportButton"
              Content="開始匯入"
              Padding="16,7"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="StartImport_Click" />
      <Button x:Name="CloseButton"
              Content="關閉"
              Padding="16,7"
              Margin="8,0,0,0"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
