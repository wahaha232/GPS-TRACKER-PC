<Window x:Class="GpsTrackerPc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GPS Tracker（PC）"
        Icon="Assets/GpsTrackerPc.ico"
        Width="1280"
        Height="860"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource AppBackground}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="0,0,0,1"
            Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock Text="🛰️ GPS Tracker（PC）"
                     Foreground="{DynamicResource AppText}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="SyncStatusText"
                     Text="尚未同步"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="12"
                     Margin="18,0,0,0"
                     MaxWidth="760"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Button x:Name="SyncButton"
                  Content="立即同步"
                  Padding="12,5"
                  Margin="0,0,8,0"
                  Background="{DynamicResource AppBorder}"
                  Foreground="{DynamicResource AppText}"
                  BorderBrush="{DynamicResource AppBorderStrong}"
                  Click="SyncButton_Click" />
          <Button Content="匯出 GPX"
                  Padding="12,5"
                  Margin="0,0,8,0"
                  Background="{DynamicResource AppBorder}"
                  Foreground="{DynamicResource AppText}"
                  BorderBrush="{DynamicResource AppBorderStrong}"
                  Click="ExportGpx_Click" />
          <Button Content="匯入 GPX"
                  Padding="12,5"
                  Margin="0,0,8,0"
                  Background="{DynamicResource AppBorder}"
                  Foreground="{DynamicResource AppText}"
                  BorderBrush="{DynamicResource AppBorderStrong}"
                  Click="ImportGpx_Click" />
          <Button Content="模擬"
                  Padding="12,5"
                  Margin="0,0,8,0"
                  Background="{DynamicResource AppBorder}"
                  Foreground="{DynamicResource AppText}"
                  BorderBrush="{DynamicResource AppBorderStrong}"
                  Click="Simulator_Click" />
          <Button Content="好友"
                  Padding="12,5"
                  Margin="0,0,8,0"
                  Background="{DynamicResource AppBorder}"
                  Foreground="{DynamicResource AppText}"
                  BorderBrush="{DynamicResource AppBorderStrong}"
                  Click="Friends_Click" />
          <Button Content="檢查雲端更新"
                  Padding="12,5"
                  Margin="0,0,8,0"
                  Background="{DynamicResource AppBorder}"
                  Foreground="{DynamicResource AppText}"
                  BorderBrush="{DynamicResource AppBorderStrong}"
                  Click="CheckCloudUpdates_Click" />
          <Button Content="設定"
                  Padding="12,5"
                  Background="{DynamicResource AppBorder}"
                  Foreground="{DynamicResource AppText}"
                  BorderBrush="{DynamicResource AppBorderStrong}"
                  Click="SettingsButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="Browser" />

      <Border x:Name="LoadingPanel" Background="{DynamicResource AppBackground}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="🛰️"
                     FontSize="44"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,12" />
          <TextBlock Text="GPS Tracker（PC）"
                     Foreground="{DynamicResource AppText}"
                     FontSize="24"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="正在載入本機網頁…"
                     Foreground="{DynamicResource AppTextMuted}"
                     FontSize="14"
                     Margin="0,8,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border x:Name="ErrorPanel"
              Background="{DynamicResource AppBackground}"
              Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="760">
          <TextBlock Text="無法啟動 GPS Tracker"
                     Foreground="{DynamicResource AppDangerText}"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Margin="0,0,0,12" />
          <TextBlock x:Name="ErrorText"
                     Foreground="{DynamicResource AppText}"
                     FontSize="14"
                     TextWrapping="Wrap"
                     LineHeight="22" />
          <Button x:Name="WebView2DownloadButton"
                  Content="下載 WebView2 Runtime"
                  Width="200"
                  Margin="0,18,0,0"
                  Padding="0,8"
                  HorizontalAlignment="Center"
                  Visibility="Collapsed"
                  Click="OpenWebView2Download_Click" />
          <Button Content="結束"
                  Width="120"
                  Margin="0,10,0,0"
                  Padding="0,8"
                  HorizontalAlignment="Center"
                  Click="Exit_Click" />
        </StackPanel>
      </Border>

      <Grid x:Name="SimulatorHost"
            Background="{DynamicResource AppBackground}"
            Visibility="Collapsed" />

      <Grid x:Name="FriendsHost"
            Background="{DynamicResource AppBackground}"
            Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>
