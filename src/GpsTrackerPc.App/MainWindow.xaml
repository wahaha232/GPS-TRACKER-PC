<Window x:Class="GpsTrackerPc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GPS Tracker（PC）"
        Width="1280"
        Height="860"
        MinWidth="900"
        MinHeight="600"
        Background="#0B1220"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid>
    <wv2:WebView2 x:Name="Browser" />

    <Border x:Name="LoadingPanel" Background="#0B1220">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="🛰️"
                   FontSize="44"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />
        <TextBlock Text="GPS Tracker（PC）"
                   Foreground="#E2E8F0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="正在載入本機網頁…"
                   Foreground="#94A3B8"
                   FontSize="14"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border x:Name="ErrorPanel"
            Background="#0B1220"
            Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="760">
        <TextBlock Text="無法啟動 GPS Tracker"
                   Foreground="#FCA5A5"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <TextBlock x:Name="ErrorText"
                   Foreground="#E2E8F0"
                   FontSize="14"
                   TextWrapping="Wrap"
                   LineHeight="22" />
        <Button Content="結束"
                Width="120"
                Margin="0,24,0,0"
                Padding="0,8"
                HorizontalAlignment="Center"
                Click="Exit_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
