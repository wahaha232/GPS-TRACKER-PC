<Window x:Class="GpsTrackerPc.App.PendingRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待上傳的模擬紀錄"
        Width="620"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
  <Grid Margin="18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="CountText"
               Foreground="{DynamicResource AppText}"
               FontSize="15"
               FontWeight="SemiBold" />
    <TextBlock Grid.Row="1"
               Text="這些紀錄尚未成功上傳。自動補傳會遵守每日上限；按「立即補傳全部」會跳過上限並公開上傳。"
               Foreground="{DynamicResource AppTextMuted}"
               FontSize="11"
               TextWrapping="Wrap"
               Margin="0,6,0,10" />

    <ListBox x:Name="RecordList"
             Grid.Row="2"
             DisplayMemberPath="Display"
             Background="{DynamicResource AppSurfaceAlt}"
             Foreground="{DynamicResource AppText}"
             BorderBrush="{DynamicResource AppBorderStrong}" />

    <TextBlock x:Name="StatusText"
               Grid.Row="3"
               Foreground="{DynamicResource AppTextMuted}"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,10,0,0" />

    <WrapPanel Grid.Row="4" Margin="0,10,0,0">
      <Button x:Name="UploadAllButton"
              Content="立即補傳全部"
              Margin="0,0,6,0"
              Click="UploadAll_Click" />
      <Button x:Name="DeleteButton"
              Content="刪除選取"
              Margin="0,0,6,0"
              Click="Delete_Click" />
      <Button Content="重新整理" Margin="0,0,6,0" Click="Refresh_Click" />
      <Button Content="關閉" Click="Close_Click" />
    </WrapPanel>
  </Grid>
</Window>
