<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 工具列圖示區（系統匣）使用 WinForms NotifyIcon。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GpsTrackerPc.App</RootNamespace>
    <AssemblyName>GpsTrackerPc</AssemblyName>
    <ApplicationIcon>Assets\GpsTrackerPc.ico</ApplicationIcon>
    <Version>0.5.3</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 網頁只維護一份：建置時從 gpstracker-web 原檔複製到輸出資料夾的 web\，不在本專案留副本。
         本機預設是本專案往上三層的 ANDROID-APP-DEV\gpstracker-web；GitHub Actions 會用 -p:WebSourceRoot 覆寫。 -->
    <WebSourceRoot Condition="'$(WebSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\ANDROID-APP-DEV\gpstracker-web\</WebSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 只用於系統匣圖示；不要讓它的命名空間成為全域 using，避免與 WPF 型別衝突。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GpsTrackerPc.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GpsTrackerPc.Core\GpsTrackerPc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(WebSourceRoot)**\*.*"
             Exclude="$(WebSourceRoot)tests\**\*.*">
      <Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 模擬視窗自己的地圖頁；單一 EXE 發佈時會一併打包，執行時解壓到 AppContext.BaseDirectory。 -->
    <Content Include="Simulator\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(WebSourceRoot)vendor\maplibre-gl.js"
             Link="Simulator\vendor\maplibre-gl.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(WebSourceRoot)vendor\maplibre-gl.css"
             Link="Simulator\vendor\maplibre-gl.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
