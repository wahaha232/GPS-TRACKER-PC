<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GpsTrackerPc.App</RootNamespace>
    <AssemblyName>GpsTrackerPc</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 網頁只維護一份：建置時從 gpstracker-web 原檔複製到輸出資料夾的 web\，不在本專案留副本。 -->
    <WebSourceRoot Condition="'$(WebSourceRoot)' == ''">D:\Claude\ANDROID-APP-DEV\gpstracker-web\</WebSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(WebSourceRoot)**\*.*">
      <Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
