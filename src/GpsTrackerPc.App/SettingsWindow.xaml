<Window x:Class="GpsTrackerPc.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="660"
        Height="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="GitHub Token"
                 Foreground="{DynamicResource AppText}"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="TokenStatusText"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="13"
                 Margin="0,6,0,0" />
      <TextBlock Text="Token 只用來編輯／上傳紀錄，會以 Windows DPAPI（CurrentUser）加密後存在本機；畫面不會顯示內容，也不會寫進程式碼或記錄檔。"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0" />
    </StackPanel>

    <PasswordBox x:Name="TokenBox"
                 Grid.Row="1"
                 Height="34"
                 Margin="0,16,0,0"
                 Padding="8,6"
                 Background="{DynamicResource AppSurfaceAlt}"
                 Foreground="{DynamicResource AppText}"
                 BorderBrush="{DynamicResource AppBorderStrong}"
                 PasswordChar="●" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,12,0,0">
      <Button Content="儲存 Token"
              Padding="14,6"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Save_Click" />
      <Button Content="刪除 Token"
              Padding="14,6"
              Margin="8,0,0,0"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Delete_Click" />
    </StackPanel>

    <ScrollViewer Grid.Row="3"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,24,0,0">
      <StackPanel>
      <Separator Background="{DynamicResource AppBorder}" />
      <TextBlock Text="本機資料夾"
                 Foreground="{DynamicResource AppText}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,16,0,0" />
      <TextBlock Text="從 GitHub 同步下來的 manifest.json、紀錄檔與 meta.json 都放在這裡；沒有網路時網頁會讀這份資料。"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0" />
      <TextBox x:Name="DataPathText"
               IsReadOnly="True"
               Margin="0,10,0,0"
               Padding="8,6"
               Background="{DynamicResource AppSurfaceAlt}"
               Foreground="{DynamicResource AppText}"
               BorderBrush="{DynamicResource AppBorderStrong}" />
      <TextBlock x:Name="DataFolderStatusText"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0" />
      <WrapPanel Margin="0,10,0,0">
        <Button Content="選擇資料夾…"
                Padding="14,6"
                Margin="0,0,8,0"
                Background="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppText}"
                BorderBrush="{DynamicResource AppBorderStrong}"
                Click="ChooseDataFolder_Click" />
        <Button Content="恢復預設"
                Padding="14,6"
                Margin="0,0,8,0"
                Background="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppText}"
                BorderBrush="{DynamicResource AppBorderStrong}"
                Click="ResetDataFolder_Click" />
        <Button Content="開啟資料夾"
                Padding="14,6"
                Background="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppText}"
                BorderBrush="{DynamicResource AppBorderStrong}"
                Click="OpenFolder_Click" />
      </WrapPanel>

      <Separator Background="{DynamicResource AppBorder}" Margin="0,16,0,0" />
      <TextBlock Text="裝置名稱"
                 Foreground="{DynamicResource AppText}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,16,0,0" />
      <TextBlock Text="上傳紀錄時使用的裝置名稱，預設 PC。多台電腦請使用不同名稱；和手機同名會被拒絕，和其他模擬裝置同名會提示會合併。"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0" />
      <TextBox x:Name="DeviceNameBox"
               Margin="0,10,0,0"
               Padding="8,6"
               Background="{DynamicResource AppSurfaceAlt}"
               Foreground="{DynamicResource AppText}"
               BorderBrush="{DynamicResource AppBorderStrong}" />
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="儲存裝置名稱"
                Padding="14,6"
                Background="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppText}"
                BorderBrush="{DynamicResource AppBorderStrong}"
                Click="SaveDeviceName_Click" />
        <TextBlock x:Name="DeviceNameStatusText"
                   Foreground="{DynamicResource AppTextMuted}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />
      </StackPanel>

      <Separator Background="{DynamicResource AppBorder}" Margin="0,16,0,0" />
      <TextBlock Text="雲端更新"
                 Foreground="{DynamicResource AppText}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,16,0,0" />
      <CheckBox x:Name="AutoCheckUpdatesCheck"
                Content="啟動時自動檢查更新（一天最多一次）"
                Foreground="{DynamicResource AppText}"
                Margin="0,8,0,0"
                Checked="AutoCheckUpdates_Changed"
                Unchecked="AutoCheckUpdates_Changed" />
      <CheckBox x:Name="BackgroundDownloadCheck"
                Content="背景下載更新檔（下載完成後可在工具列安裝）"
                Foreground="{DynamicResource AppText}"
                Margin="0,6,0,0"
                Checked="BackgroundDownload_Changed"
                Unchecked="BackgroundDownload_Changed" />
      <CheckBox x:Name="AutoInstallUpdateCheck"
                Content="下載後自動安裝（安裝完成後提醒重啟程式）"
                Foreground="{DynamicResource AppText}"
                Margin="0,6,0,0"
                Checked="AutoInstallUpdate_Changed"
                Unchecked="AutoInstallUpdate_Changed" />
      <CheckBox x:Name="AutoUploadPendingCheck"
                Content="每隔幾分鐘比對並自動補傳未上傳的模擬紀錄"
                Foreground="{DynamicResource AppText}"
                Margin="0,6,0,0"
                Checked="AutoUploadPending_Changed"
                Unchecked="AutoUploadPending_Changed" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="更新通道" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="UpdateChannelBox"
                  Width="140"
                  SelectedValuePath="Tag"
                  SelectionChanged="UpdateChannel_Changed">
          <ComboBoxItem Content="穩定版" Tag="Stable" />
          <ComboBoxItem Content="測試版（beta Release）" Tag="Beta" />
        </ComboBox>
      </StackPanel>
      <CheckBox x:Name="UnmeteredOnlyCheck"
                Content="只在非計量網路背景下載（行動寬頻視為計量）"
                Foreground="{DynamicResource AppText}"
                Margin="0,6,0,0"
                Checked="UnmeteredOnly_Changed"
                Unchecked="UnmeteredOnly_Changed" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="每日自動補傳上限" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="DailyUploadLimitBox" Width="60" LostFocus="DailyUploadLimit_LostFocus" />
        <TextBlock Text="筆（1–200）" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
      <WrapPanel Margin="0,8,0,0">
        <Button Content="管理待上傳紀錄" Margin="0,0,6,6" Click="OpenPendingRecords_Click" />
        <Button Content="回復上一個版本" Margin="0,0,6,6" Click="Rollback_Click" />
        <Button Content="重設重啟詢問" Margin="0,0,6,6" Click="ResetRestartPrompt_Click" />
      </WrapPanel>
      <TextBlock x:Name="LastCheckText"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0" />
      <TextBlock Text="背景下載會先存到本機 updates 資料夾並驗證 SHA-256；安裝只替換程式檔，重啟後才會套用新版本。"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0" />

      <Separator Background="{DynamicResource AppBorder}" Margin="0,16,0,0" />
      <TextBlock Text="視窗行為"
                 Foreground="{DynamicResource AppText}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,16,0,0" />
      <CheckBox x:Name="MinimizeToTrayCheck"
                Content="縮小視窗時收到工具列圖示區（系統匣），模擬會在背景繼續執行"
                Foreground="{DynamicResource AppText}"
                Margin="0,8,0,0"
                Checked="MinimizeToTray_Changed"
                Unchecked="MinimizeToTray_Changed" />
      <TextBlock Text="開啟後，主視窗縮小會隱藏到系統匣；模擬路線編輯在同一個視窗內，切回首頁或縮小都會繼續在背景執行。圖示選單可回到視窗或結束程式；按關閉（X）仍會結束程式。"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0" />

      <Separator Background="{DynamicResource AppBorder}" Margin="0,16,0,0" />
      <TextBlock Text="外觀"
                 Foreground="{DynamicResource AppText}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Margin="0,16,0,0" />
      <TextBlock Text="主題"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 Margin="0,8,0,0" />
      <ComboBox x:Name="ThemeBox"
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                Margin="0,6,0,0"
                SelectionChanged="Theme_Changed" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <TextBlock x:Name="VersionText"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 VerticalAlignment="Center"
                 Margin="0,0,14,0" />
      <Button Content="套用"
              Padding="14,7"
              Margin="0,0,8,0"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="ApplySettings_Click" />
      <Button Content="檢查更新"
              Padding="14,7"
              Margin="0,0,8,0"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="CheckUpdates_Click" />
      <Button Content="關閉"
              Width="110"
              Padding="0,7"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
