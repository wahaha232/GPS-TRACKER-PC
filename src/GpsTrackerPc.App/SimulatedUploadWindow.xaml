<Window x:Class="GpsTrackerPc.App.SimulatedUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上傳模擬紀錄"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        Closing="Window_Closing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="上傳成紀錄"
                 Foreground="#E2E8F0"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="把這次模擬的取樣轉成網站紀錄。GPS 中斷期間不會寫入位置。"
                 Foreground="#94A3B8"
                 FontSize="12"
                 Margin="0,6,0,0" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="#0F172A"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14"
            Margin="0,14,0,0">
      <TextBlock x:Name="SummaryText"
                 Foreground="#E2E8F0"
                 FontSize="13"
                 LineHeight="24"
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="2"
                Margin="0,14,0,0">
      <TextBlock Text="開始時間（預設現在）"
                 Foreground="#E2E8F0"
                 FontSize="13"
                 FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBox x:Name="StartTimeBox"
                 Width="240"
                 TextChanged="StartTimeBox_TextChanged" />
        <Button Content="現在"
                Margin="8,0,0,0"
                Background="#1E293B"
                Foreground="#E2E8F0"
                BorderBrush="#334155"
                Click="Now_Click" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="3"
            Background="#3B1D1D"
            BorderBrush="#7F1D1D"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,16,0,0"
            VerticalAlignment="Top">
      <TextBlock Text="⚠️ 上傳後紀錄會寫入公開的 GitHub 倉庫，任何人都看得到路線與時間。裝置會標記為 PC，來源標記為 simulated。"
                 Foreground="#FCA5A5"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

    <TextBlock x:Name="StatusText"
               Grid.Row="4"
               Foreground="#94A3B8"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,12,0,0" />

    <StackPanel Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button x:Name="UploadButton"
              Content="確認上傳"
              Padding="16,7"
              Background="#1E293B"
              Foreground="#E2E8F0"
              BorderBrush="#334155"
              Click="Upload_Click" />
      <Button x:Name="CloseButton"
              Content="取消"
              Padding="16,7"
              Margin="8,0,0,0"
              Background="#1E293B"
              Foreground="#E2E8F0"
              BorderBrush="#334155"
              Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
