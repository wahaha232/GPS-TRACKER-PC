<Window x:Class="GpsTrackerPc.App.SavedRoutesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="已存路線"
        Width="760"
        Height="540"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="已存路線"
                 Foreground="{DynamicResource AppText}"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="路線存在 %LOCALAPPDATA%\GpsTrackerPc\routes\，檔案內容使用 RouteJsonCodec。"
                 Foreground="{DynamicResource AppTextMuted}"
                 FontSize="12"
                 Margin="0,6,0,0" />
    </StackPanel>

    <ListBox x:Name="RouteList"
             Grid.Row="1"
             Margin="0,14,0,0"
             Background="{DynamicResource AppSurfaceAlt}"
             Foreground="{DynamicResource AppText}"
             BorderBrush="{DynamicResource AppBorder}"
             DisplayMemberPath="Display" />

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Foreground="{DynamicResource AppTextMuted}"
               FontSize="12"
               Margin="0,10,0,0"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button Content="載入"
              Padding="16,7"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Load_Click" />
      <Button Content="刪除"
              Padding="16,7"
              Margin="8,0,0,0"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Delete_Click" />
      <Button Content="關閉"
              Padding="16,7"
              Margin="8,0,0,0"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
