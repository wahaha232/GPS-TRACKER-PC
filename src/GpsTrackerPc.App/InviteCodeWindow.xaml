<Window x:Class="GpsTrackerPc.App.InviteCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="好友分享"
        Width="560"
        SizeToContent="Height"
        MinHeight="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Loaded="Window_Loaded">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="PromptText"
               Grid.Row="0"
               Foreground="{DynamicResource AppText}"
               FontSize="16"
               FontWeight="SemiBold"
               TextWrapping="Wrap" />

    <TextBox x:Name="ValueBox"
             Grid.Row="1"
             Margin="0,14,0,0"
             MinHeight="36"
             MaxHeight="150"
             Padding="8,6"
             Background="{DynamicResource AppSurfaceAlt}"
             Foreground="{DynamicResource AppText}"
             BorderBrush="{DynamicResource AppBorderStrong}"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" />

    <TextBlock x:Name="HintText"
               Grid.Row="2"
               Margin="0,10,0,0"
               Foreground="{DynamicResource AppTextMuted}"
               FontSize="12"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button Content="取消"
              Width="100"
              Padding="0,7"
              Margin="0,0,8,0"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              IsCancel="True"
              Click="Cancel_Click" />
      <Button Content="確定"
              Width="100"
              Padding="0,7"
              IsDefault="True"
              Background="{DynamicResource AppBorder}"
              Foreground="{DynamicResource AppText}"
              BorderBrush="{DynamicResource AppBorderStrong}"
              Click="Ok_Click" />
    </StackPanel>
  </Grid>
</Window>
