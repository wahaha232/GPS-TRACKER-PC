<Window x:Class="GpsTrackerPc.App.ResumeSimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模擬路線尚未結束"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
  <StackPanel Margin="22,18">
    <TextBlock Text="上次重新啟動前，模擬路線已暫停"
               Foreground="{DynamicResource AppText}"
               FontSize="17"
               FontWeight="SemiBold" />
    <TextBlock x:Name="SummaryText"
               Foreground="{DynamicResource AppTextMuted}"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,8,0,0" />
    <Button Content="從暫停點繼續模擬路線"
            Margin="0,16,0,0"
            Padding="14,8"
            HorizontalAlignment="Stretch"
            Click="Continue_Click" />
    <Button Content="直接存檔並結束模擬路線"
            Margin="0,8,0,0"
            Padding="14,8"
            HorizontalAlignment="Stretch"
            Click="SaveAndEnd_Click" />
    <Button Content="不存檔直接放棄模擬路線"
            Margin="0,8,0,0"
            Padding="14,8"
            HorizontalAlignment="Stretch"
            Click="Discard_Click" />
    <CheckBox x:Name="RememberChoiceCheck"
              Content="記住這個選擇（之後不再詢問，可在設定重設）"
              Foreground="{DynamicResource AppTextMuted}"
              Margin="0,14,0,0" />
    <TextBlock Text="存檔會先放進本機待上傳清單；只有路線草稿時會存到本機路線庫。網路恢復或定期檢查時會自動上傳。"
               Foreground="{DynamicResource AppTextMuted}"
               FontSize="11"
               TextWrapping="Wrap"
               Margin="0,10,0,0" />
  </StackPanel>
</Window>
